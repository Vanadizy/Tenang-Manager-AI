<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing assets and files as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Let React Router handle client-side routes on direct visits and refreshes.
  RewriteRule ^ index.html [L]
</IfModule>
